@echo off
chcp 65001
cd /d %~dp0

echo ==========================================
echo  GitHubへ自動バックアップを開始します...
echo ==========================================

:: ▼【修正1】pullはいったん無効化します（エラー回避のため）
:: git pull origin main

:: 全ファイルを登録
git add .

:: 日付と時刻をメッセージにしてコミット
git commit -m "自動バックアップ: %date% %time%"

:: ▼【修正2】ブランチ名を自動判定(HEAD)に変更
git push origin HEAD

echo ==========================================
echo  完了しました！
echo ==========================================
pause
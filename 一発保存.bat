@echo off
chcp 65001
cd /d %~dp0

echo ==========================================
echo  GitHubへ自動バックアップを開始します...
echo ==========================================

:: まず最新の状態を取得（念のため）
git pull origin main

:: 全ファイルを登録
git add .

:: 日付と時刻をメッセージにしてコミット
git commit -m "自動バックアップ: %date% %time%"

:: GitHubへ送信
git push origin main

echo ==========================================
echo  完了しました！画面を閉じます。
echo ==========================================
pause